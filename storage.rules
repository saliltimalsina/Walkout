rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Posters + fighter photos are public-read; only admins write from the
    // client. Functions/seed upload via the Admin SDK (bypasses rules).
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
