<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash (dark mode): black screen, no icon. The in-app
     cinematic splash opens on pure darkness, so launch reads as one shot. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_door_anim</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
