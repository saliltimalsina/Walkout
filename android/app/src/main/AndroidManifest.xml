            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_octagon_count_info" />
        </receiver>
        <receiver
            android:name=".widgets.Last5WidgetProvider"
            android:exported="true"
            android:label="Last 5 Fights">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_last5_info" />
        </receiver>
        <receiver
